{
  "version": 2,
  "name": "segura-m4-community-app",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_M3_URL": "https://segura-m3-sos-server.onrender.com",
    "VITE_M2_URL": "https://segura-m2-ai-engine.onrender.com"
  }
}
